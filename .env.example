# ── GENERAL ───────────────────────────────────────────────────────
# Run an initial scrape as soon as the container/process starts.
# Default: true
RUN_ON_START=true

# ── CRON ──────────────────────────────────────────────────────────
# Cron expression. Default: midnight every day.
# Format: minute hour day-of-month month day-of-week
#   CRON=0 0 * * *          → daily at 00:00
#   CRON=0 17 * * 1-5       → weekdays at 17:00
#   CRON=0 9,18 * * *       → daily at 09:00 and 18:00
CRON=0 0 * * *

# IANA timezone used to interpret CRON. Default: Europe/Madrid.
# The scraped "next days" are always calculated in Europe/Madrid because
# the Filmoteca programme is in Madrid.
CRON_TIMEZONE=Europe/Madrid

# ── STORAGE ───────────────────────────────────────────────────────
# Optional. If set, each run saves:
#   {DATA_DIR}/{command}/{timestamp}-info.{ext}
#   {DATA_DIR}/{command}/{timestamp}-programa.pdf
# Commands: server, manual, ask.
# Leave commented/empty to disable persistence.
# DATA_DIR=./data

# ── EMAIL ─────────────────────────────────────────────────────────
# Email notifications via SMTP.
# Required to enable email: SMTP_HOST, SMTP_PORT, EMAIL_FROM, EMAIL_TO.
# SMTP_USER/SMTP_PASS are optional for local relays such as Mailpit.

# SMTP server
SMTP_HOST=smtp.gmail.com
# port (587 STARTTLS, 465 SSL)
SMTP_PORT=587
# SMTP account username (optional for relays without auth)
SMTP_USER=
# SMTP account password or app password (optional for relays without auth)
SMTP_PASS=
# sender (e.g. "Filmoteca Notify" <f@x.com> or just f@x.com)
EMAIL_FROM=
# recipient(s). Use commas for multiple: a@x.com,b@x.com
EMAIL_TO=

# ── GOTIFY ────────────────────────────────────────────────────────
# Push notifications via Gotify (https://gotify.net).
# Both variables are required to enable Gotify.

# Gotify server URL (e.g. http://gotify:80)
GOTIFY_URL=
# Gotify application token
GOTIFY_TOKEN=
